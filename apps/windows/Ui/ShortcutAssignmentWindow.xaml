<Window x:Class="VolturaWeekNumber.Ui.ShortcutAssignmentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:VolturaWeekNumber.Ui"
    Title="{Binding [ActivationShortcut], Source={x:Static ui:Strings.Current}}" Width="620" Height="500" MinWidth="520" MinHeight="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ui:SpacingStackPanel Spacing="14" Margin="28,24,28,20">
        <TextBlock Text="{Binding [ActivationShortcut], Source={x:Static ui:Strings.Current}}" FontSize="24" FontWeight="SemiBold" AutomationProperties.Name="{Binding [ActivationShortcut], Source={x:Static ui:Strings.Current}}"/>
        <TextBlock Text="{Binding [ShortcutGuidance], Source={x:Static ui:Strings.Current}}" Foreground="{DynamicResource MutedBrush}"/>
        <Border x:Name="CaptureSurface" MinHeight="132" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Focusable="True" MouseLeftButtonDown="CaptureSurfaceClick" AutomationProperties.Name="{Binding [ShortcutPrompt], Source={x:Static ui:Strings.Current}}">
          <Grid>
            <TextBlock x:Name="PromptText" Text="{Binding [ShortcutPrompt], Source={x:Static ui:Strings.Current}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
            <ItemsControl x:Name="KeyTiles" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border MinWidth="62" Height="58" Margin="5,0" Padding="14,8" CornerRadius="9" BorderThickness="1">
                  <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"><Setter Property="Background" Value="{DynamicResource ErrorAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ErrorTextBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></Border.Style>
                  <Grid>
                    <TextBlock Text="{Binding Text}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="NoWrap">
                      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding Glyph}" Value="True"><Setter Property="FontFamily" Value="Segoe Fluent Icons"/></DataTrigger><DataTrigger Binding="{Binding Large}" Value="True"><Setter Property="FontSize" Value="22"/></DataTrigger><DataTrigger Binding="{Binding WindowsLogo}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorAccentTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Path Data="M0,0 H10 V10 H0 Z M14,0 H24 V10 H14 Z M0,14 H10 V24 H0 Z M14,14 H24 V24 H14 Z" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Fill" Value="{DynamicResource AccentTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding WindowsLogo}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"><Setter Property="Fill" Value="{DynamicResource ErrorAccentTextBrush}"/></DataTrigger></Style.Triggers></Style></Path.Style>
                    </Path>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
        <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button x:Name="ResetButton" Width="Auto" Height="Auto" Padding="10,6" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}" Click="ResetClick" AutomationProperties.Name="{Binding [ShortcutReset], Source={x:Static ui:Strings.Current}}">
            <ui:SpacingStackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE777;" Style="{StaticResource ButtonGlyph}"/><TextBlock Text="{Binding [ShortcutReset], Source={x:Static ui:Strings.Current}}" Foreground="{DynamicResource AccentBrush}"/></ui:SpacingStackPanel>
          </Button>
          <Button x:Name="ClearButton" Width="Auto" Height="Auto" Padding="10,6" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}" Click="ClearClick" AutomationProperties.Name="{Binding [ShortcutClear], Source={x:Static ui:Strings.Current}}">
            <ui:SpacingStackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="&#xE894;" Style="{StaticResource ButtonGlyph}"/><TextBlock Text="{Binding [ShortcutClear], Source={x:Static ui:Strings.Current}}" Foreground="{DynamicResource AccentBrush}"/></ui:SpacingStackPanel>
          </Button>
        </ui:SpacingStackPanel>
        <Border x:Name="ConflictBanner" Visibility="Collapsed" Background="{DynamicResource WarningBrush}" CornerRadius="6" Padding="12,10" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding [ShortcutConflict], Source={x:Static ui:Strings.Current}}">
          <ui:SpacingStackPanel Orientation="Horizontal" Spacing="9"><Grid x:Name="ConflictIcon" Width="20" Height="20" VerticalAlignment="Center"><Ellipse Fill="{DynamicResource WarningTextBrush}"/><TextBlock Text="!" Foreground="{DynamicResource WarningBrush}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,-1,0,0"/></Grid><TextBlock Text="{Binding [ShortcutConflict], Source={x:Static ui:Strings.Current}}" Foreground="{DynamicResource WarningTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/></ui:SpacingStackPanel>
        </Border>
        <Border x:Name="InvalidBanner" Visibility="Collapsed" Background="{DynamicResource ErrorBrush}" CornerRadius="6" Padding="12,10" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding [ShortcutInvalid], Source={x:Static ui:Strings.Current}}">
          <ui:SpacingStackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="&#xE711;" Style="{StaticResource ButtonGlyph}" Foreground="{DynamicResource ErrorTextBrush}"/><TextBlock Text="{Binding [ShortcutInvalid], Source={x:Static ui:Strings.Current}}" Foreground="{DynamicResource ErrorTextBrush}" FontWeight="SemiBold"/></ui:SpacingStackPanel>
        </Border>
      </ui:SpacingStackPanel>
    </ScrollViewer>
    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="SaveButton" Grid.Column="0" Width="Auto" IsDefault="True" Click="SaveClick" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" AutomationProperties.Name="{Binding [ShortcutSave], Source={x:Static ui:Strings.Current}}"><TextBlock Text="{Binding [ShortcutSave], Source={x:Static ui:Strings.Current}}" Foreground="{DynamicResource AccentTextBrush}"/></Button>
        <Button Grid.Column="2" Width="Auto" IsCancel="True" AutomationProperties.Name="{Binding [ShortcutCancel], Source={x:Static ui:Strings.Current}}"><TextBlock Text="{Binding [ShortcutCancel], Source={x:Static ui:Strings.Current}}"/></Button>
      </Grid>
    </Border>
  </Grid>
</Window>
