<UserControl x:Class="VolturaWeekNumber.Ui.CalendarBrowserPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:VolturaWeekNumber.Ui" SizeChanged="PageSizeChanged">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="VisibleIf"/>
    <Style x:Key="CalendarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="Auto"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style x:Key="WeekMark" TargetType="Border">
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2,0,0,0"/>
      <Setter Property="Padding" Value="5,3,2,3"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="WeekLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="DayMark" TargetType="Border">
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2"/>
      <Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="2,6"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="DayNumber" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOutsideMonth}" Value="True"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="FontWeight" Value="Bold"/></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <ScrollViewer x:Name="CalendarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ui:SpacingStackPanel Spacing="12" Margin="0,20,12,4">
      <WrapPanel x:Name="Breadcrumbs" Visibility="{Binding IsYear, Converter={x:Static ui:CalendarBrowserPage.HiddenWhenTrue}}">
        <Button x:Name="YearBreadcrumb" Style="{StaticResource CalendarButton}" Height="40" Padding="12,8" Click="YearClick" AutomationProperties.Name="{Binding YearText}">
          <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#xE74A;" Style="{StaticResource ButtonGlyph}"/><TextBlock Text="{Binding YearText}"/></ui:SpacingStackPanel>
        </Button>
        <TextBlock Text="›" Margin="8,0" VerticalAlignment="Center" Visibility="{Binding IsWeek, Converter={StaticResource VisibleIf}}"/>
        <Button x:Name="MonthBreadcrumb" Style="{StaticResource CalendarButton}" Height="40" Padding="12,8" Click="MonthClick" Content="{Binding MonthText}" AutomationProperties.Name="{Binding MonthText}" Visibility="{Binding IsWeek, Converter={StaticResource VisibleIf}}"/>
      </WrapPanel>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="PreviousPeriod" Width="40" Padding="0" Click="PreviousClick" IsEnabled="{Binding CanPrevious}" ToolTip="{Binding PreviousLabel}" AutomationProperties.Name="{Binding PreviousLabel}"><TextBlock Text="&#xE76B;" Style="{StaticResource ButtonGlyph}"/></Button>
        <TextBlock x:Name="PeriodTitle" Grid.Column="1" Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="NextPeriod" Grid.Column="2" Width="40" Padding="0" Click="NextClick" IsEnabled="{Binding CanNext}" ToolTip="{Binding NextLabel}" AutomationProperties.Name="{Binding NextLabel}"><TextBlock Text="&#xE76C;" Style="{StaticResource ButtonGlyph}"/></Button>
        <Button x:Name="TodayButton" Grid.Column="4" Width="Auto" MinWidth="100" Click="TodayClick" AutomationProperties.Name="{Binding [Today], Source={x:Static ui:Strings.Current}}">
          <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#xE8D1;" Style="{StaticResource ButtonGlyph}"/><TextBlock Text="{Binding [Today], Source={x:Static ui:Strings.Current}}"/></ui:SpacingStackPanel>
        </Button>
      </Grid>
      <TextBlock Text="{Binding ConventionText}" Style="{StaticResource Caption}"/>
      <TextBlock Text="{Binding ErrorText}" Visibility="{Binding HasPeriod, Converter={x:Static ui:CalendarBrowserPage.HiddenWhenTrue}}" AutomationProperties.LiveSetting="Polite"/>
      <ui:SpacingStackPanel Spacing="12" Visibility="{Binding HasPeriod, Converter={StaticResource VisibleIf}}">
        <TextBlock Text="{Binding HelpText}" Style="{StaticResource Caption}" Visibility="{Binding IsWeek, Converter={x:Static ui:CalendarBrowserPage.HiddenWhenTrue}}"/>
        <ItemsControl x:Name="YearMonths" ItemsSource="{Binding Months}" Visibility="{Binding IsYear, Converter={StaticResource VisibleIf}}" Margin="-4,0">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding MonthColumns, RelativeSource={RelativeSource AncestorType=ui:CalendarBrowserPage}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Style="{StaticResource CalendarButton}" Click="OpenMonthClick" Margin="4,4" Padding="8,10" AutomationProperties.Name="{Binding AccessibleName}">
              <ui:SpacingStackPanel Spacing="8">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" Margin="7,0"/>
                <ItemsControl ItemsSource="{Binding Weeks}" IsHitTestVisible="False" Focusable="False">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource WeekMark}" AutomationProperties.Name="{Binding AccessibleName}">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NumberText}" Style="{StaticResource WeekLabel}" FontSize="12" Margin="0,0,8,0" MaxWidth="76"/>
                        <TextBlock Grid.Column="1" Text="{Binding RangeText}" Style="{StaticResource Caption}"/>
                      </Grid>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </ui:SpacingStackPanel>
            </Button>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ui:SpacingStackPanel Spacing="6" Visibility="{Binding IsMonth, Converter={StaticResource VisibleIf}}">
          <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [Week], Source={x:Static ui:Strings.Current}}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Weekdays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </Grid>
          <ItemsControl x:Name="MonthWeeks" ItemsSource="{Binding Weeks}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Style="{StaticResource CalendarButton}" Margin="0,3" Padding="10,6" Click="OpenWeekClick" AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding RangeText}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource WeekMark}" VerticalAlignment="Center"><TextBlock Text="{Binding NumberText}" Style="{StaticResource WeekLabel}" FontSize="12"/></Border>
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource DayMark}" AutomationProperties.Name="{Binding AccessibleName}"><TextBlock Text="{Binding Number}" Style="{StaticResource DayNumber}"/></Border>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:SpacingStackPanel>
        <ui:SpacingStackPanel Spacing="14" Visibility="{Binding IsWeek, Converter={StaticResource VisibleIf}}">
          <TextBlock Text="{Binding RangeText}"/>
          <ItemsControl x:Name="WeekDays" ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource DayMark}" Background="{DynamicResource SurfaceBrush}" Margin="2,0" Padding="4,14" AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding AccessibleName}">
                <ui:SpacingStackPanel Spacing="10">
                  <TextBlock Text="{Binding Weekday}" TextAlignment="Center" FontSize="12"/>
                  <TextBlock Text="{Binding Number}" Style="{StaticResource DayNumber}" FontSize="26"/>
                  <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" TextAlignment="Center"/>
                </ui:SpacingStackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding TodayText}" Style="{StaticResource Caption}"/>
        </ui:SpacingStackPanel>
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="8,2" Visibility="{Binding IsWeek, Converter={x:Static ui:CalendarBrowserPage.HiddenWhenTrue}}"><TextBlock Text="{Binding [CurrentWeek], Source={x:Static ui:Strings.Current}}" Style="{StaticResource Caption}"/></Border>
      </ui:SpacingStackPanel>
    </ui:SpacingStackPanel>
  </ScrollViewer>
</UserControl>
