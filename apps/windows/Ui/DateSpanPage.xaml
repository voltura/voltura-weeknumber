<UserControl x:Class="VolturaWeekNumber.Ui.DateSpanPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:VolturaWeekNumber.Ui">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ui:SpacingStackPanel Spacing="18" Margin="0,20,0,4">
      <TextBlock Text="{Binding [DateSpanHelp], Source={x:Static ui:Strings.Current}}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22" AutomationProperties.LiveSetting="Polite">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <ui:SpacingStackPanel Spacing="4">
            <TextBlock x:Name="CalendarDaysResult" Text="{Binding CalendarDays}" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding [CalendarDays], Source={x:Static ui:Strings.Current}}" Style="{StaticResource Caption}"/>
          </ui:SpacingStackPanel>
          <ui:SpacingStackPanel Grid.Column="2" Spacing="4">
            <TextBlock x:Name="WholeWeeksResult" Text="{Binding WholeWeeks}" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding [WholeWeeks], Source={x:Static ui:Strings.Current}}" Style="{StaticResource Caption}"/>
          </ui:SpacingStackPanel>
          <ui:SpacingStackPanel Grid.Row="2" Spacing="4">
            <TextBlock x:Name="WeekdaysResult" Text="{Binding Weekdays}" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding [Weekdays], Source={x:Static ui:Strings.Current}}" Style="{StaticResource Caption}"/>
          </ui:SpacingStackPanel>
          <ui:SpacingStackPanel Grid.Row="2" Grid.Column="2" Spacing="4">
            <TextBlock x:Name="WeekendDaysResult" Text="{Binding WeekendDays}" FontSize="32" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding [WeekendDays], Source={x:Static ui:Strings.Current}}" Style="{StaticResource Caption}"/>
          </ui:SpacingStackPanel>
        </Grid>
      </Border>
      <ui:SpacingStackPanel Spacing="8">
        <TextBlock Text="{Binding [ChooseDates], Source={x:Static ui:Strings.Current}}" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="{Binding [FirstDate], Source={x:Static ui:Strings.Current}}"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <DatePicker x:Name="FirstDateInput" SelectedDate="{Binding FirstDate}" SelectedDateFormat="Short" Height="40" AutomationProperties.Name="{Binding [FirstDate], Source={x:Static ui:Strings.Current}}"/>
          <Button x:Name="FirstTodayButton" Grid.Column="2" Click="FirstTodayClick" ToolTip="{Binding [FirstDateToday], Source={x:Static ui:Strings.Current}}" AutomationProperties.Name="{Binding [FirstDateToday], Source={x:Static ui:Strings.Current}}">
            <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="&#xE8D1;" Style="{StaticResource ButtonGlyph}"/>
              <TextBlock Text="{Binding [Today], Source={x:Static ui:Strings.Current}}"/>
            </ui:SpacingStackPanel>
          </Button>
        </Grid>
        <TextBlock Text="{Binding [SecondDate], Source={x:Static ui:Strings.Current}}" Margin="0,4,0,0"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <DatePicker x:Name="SecondDateInput" SelectedDate="{Binding SecondDate}" SelectedDateFormat="Short" Height="40" AutomationProperties.Name="{Binding [SecondDate], Source={x:Static ui:Strings.Current}}"/>
          <Button x:Name="SecondTodayButton" Grid.Column="2" Click="SecondTodayClick" ToolTip="{Binding [SecondDateToday], Source={x:Static ui:Strings.Current}}" AutomationProperties.Name="{Binding [SecondDateToday], Source={x:Static ui:Strings.Current}}">
            <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="&#xE8D1;" Style="{StaticResource ButtonGlyph}"/>
              <TextBlock Text="{Binding [Today], Source={x:Static ui:Strings.Current}}"/>
            </ui:SpacingStackPanel>
          </Button>
        </Grid>
      </ui:SpacingStackPanel>
    </ui:SpacingStackPanel>
  </ScrollViewer>
</UserControl>
