<Window x:Class="VolturaWeekNumber.Ui.ColorPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:VolturaWeekNumber.Ui"
    Width="560" Height="400" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <DockPanel Margin="20">
    <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,16,-8,-8">
      <Button IsCancel="True" Margin="0,0,8,8" AutomationProperties.Name="{Binding [Dismiss], Source={x:Static ui:Strings.Current}}">
        <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="&#xE711;" Style="{StaticResource ButtonGlyph}"/>
          <TextBlock Text="{Binding [Dismiss], Source={x:Static ui:Strings.Current}}"/>
        </ui:SpacingStackPanel>
      </Button>
      <Button IsDefault="True" Click="AcceptClick" Margin="0,0,8,8" AutomationProperties.Name="{Binding [UseColor], Source={x:Static ui:Strings.Current}}">
        <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="&#xE8FB;" Style="{StaticResource ButtonGlyph}"/>
          <TextBlock Text="{Binding [UseColor], Source={x:Static ui:Strings.Current}}"/>
        </ui:SpacingStackPanel>
      </Button>
    </WrapPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ui:SpacingStackPanel Spacing="10">
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12"><ui:SpacingStackPanel Orientation="Horizontal" Spacing="14">
        <Border x:Name="Swatch" Width="48" Height="48" CornerRadius="6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
        <TextBlock x:Name="Hex" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"/>
      </ui:SpacingStackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="R"/><Slider x:Name="Red" Grid.Column="1" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ChannelChanged" AutomationProperties.Name="{Binding [Red], Source={x:Static ui:Strings.Current}}"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="G"/><Slider x:Name="Green" Grid.Column="1" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ChannelChanged" AutomationProperties.Name="{Binding [Green], Source={x:Static ui:Strings.Current}}"/></Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="B"/><Slider x:Name="Blue" Grid.Column="1" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ChannelChanged" AutomationProperties.Name="{Binding [Blue], Source={x:Static ui:Strings.Current}}"/></Grid>
      <TextBlock Text="{Binding [Opacity], Source={x:Static ui:Strings.Current}}"/>
      <Slider x:Name="Alpha" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ChannelChanged" AutomationProperties.Name="{Binding [Opacity], Source={x:Static ui:Strings.Current}}"/>
    </ui:SpacingStackPanel></ScrollViewer>
  </DockPanel>
</Window>
