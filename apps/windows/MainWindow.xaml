<Window x:Class="VolturaWeekNumber.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:VolturaWeekNumber.Ui"
  Title="Voltura WeekNumber" Width="800" Height="640" MinWidth="560" MinHeight="280" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="HeaderPinToggle" TargetType="ToggleButton">
      <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource WindowBrush}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <DockPanel.Style><Style TargetType="DockPanel">
      <Setter Property="Margin" Value="20"/>
      <Style.Triggers><DataTrigger Binding="{Binding IsSelected, ElementName=PreferencesTab}" Value="True"><Setter Property="Margin" Value="20,20,20,12"/></DataTrigger></Style.Triggers>
    </Style></DockPanel.Style>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="12" MinHeight="20" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite">
      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Style.Triggers><DataTrigger Binding="{Binding IsSelected, ElementName=PreferencesTab}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style>
    </TextBlock>
    <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Height" Value="40"/>
          <Setter Property="Margin" Value="0,0,2,0"/>
          <Setter Property="Padding" Value="8,0"/>
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
          <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2"/>
          <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="TabItem">
              <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Panel.ZIndex" Value="1"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value></Setter>
        </Style>
      </TabControl.Resources>
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <WrapPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
              <ToggleButton x:Name="HeaderPinToggle" Grid.Column="1" Style="{StaticResource HeaderPinToggle}" Margin="12,0,0,0" VerticalAlignment="Top" IsChecked="{Binding Editor.AlwaysOnTop}" Click="AlwaysOnTopClick" ToolTip="{Binding [AlwaysOnTop], Source={x:Static ui:Strings.Current}}" AutomationProperties.Name="{Binding [AlwaysOnTop], Source={x:Static ui:Strings.Current}}" AutomationProperties.HelpText="{Binding [AlwaysOnTop], Source={x:Static ui:Strings.Current}}" KeyboardNavigation.TabIndex="2">
                <TextBlock Text="&#xE718;" Style="{StaticResource ButtonGlyph}" FontSize="16"><TextBlock.RenderTransform><TranslateTransform Y="-1"/></TextBlock.RenderTransform></TextBlock>
              </ToggleButton>
            </Grid>
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem Header="{Binding [WeekTab], Source={x:Static ui:Strings.Current}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ui:SpacingStackPanel Spacing="18" Margin="0,20,0,4">
            <TextBlock Text="{Binding [Intro], Source={x:Static ui:Strings.Current}}" Style="{StaticResource Caption}"/>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
              <ui:SpacingStackPanel Spacing="14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Image Source="{Binding Preview}" Width="96" Height="96" Stretch="Uniform" AutomationProperties.Name="{Binding WeekText}"/>
                  <ui:SpacingStackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WeekText}" FontSize="32" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DateText}"/>
                    <TextBlock Text="{Binding WeekYearText}" Style="{StaticResource Caption}"/>
                  </ui:SpacingStackPanel>
                </Grid>
                <ui:WeekCopyControl x:Name="SelectedWeekCopy" IsEnabled="{Binding CanCopyWeek}"/>
              </ui:SpacingStackPanel>
            </Border>
            <ui:SpacingStackPanel Spacing="8">
              <TextBlock Text="{Binding [ChooseDate], Source={x:Static ui:Strings.Current}}" FontWeight="SemiBold"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="40"/><ColumnDefinition Width="8"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Button x:Name="PreviousWeekButton" Width="40" Padding="0" Click="PreviousWeekClick" IsEnabled="{Binding CanMovePreviousWeek}" ToolTip="{Binding [PreviousWeek], Source={x:Static ui:Strings.Current}}" AutomationProperties.Name="{Binding [PreviousWeek], Source={x:Static ui:Strings.Current}}">
                  <TextBlock Text="&#xE76B;" Style="{StaticResource ButtonGlyph}"/>
                </Button>
                <DatePicker x:Name="DateInput" Grid.Column="2" SelectedDate="{Binding SelectedDate}" SelectedDateFormat="Short" Height="40" AutomationProperties.Name="{Binding [ChooseDate], Source={x:Static ui:Strings.Current}}"/>
                <Button x:Name="NextWeekButton" Grid.Column="4" Width="40" Padding="0" Click="NextWeekClick" IsEnabled="{Binding CanMoveNextWeek}" ToolTip="{Binding [NextWeek], Source={x:Static ui:Strings.Current}}" AutomationProperties.Name="{Binding [NextWeek], Source={x:Static ui:Strings.Current}}">
                  <TextBlock Text="&#xE76C;" Style="{StaticResource ButtonGlyph}"/>
                </Button>
                <Button Grid.Column="6" Click="TodayClick" AutomationProperties.Name="{Binding [Today], Source={x:Static ui:Strings.Current}}">
                  <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE8D1;" Style="{StaticResource ButtonGlyph}"/>
                    <TextBlock Text="{Binding [Today], Source={x:Static ui:Strings.Current}}"/>
                  </ui:SpacingStackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{Binding ConventionText}" Style="{StaticResource Caption}"/>
              <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="96"/><ColumnDefinition Width="8"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [WeeksFromToday], Source={x:Static ui:Strings.Current}}" VerticalAlignment="Center"/>
                <TextBox x:Name="WeekOffsetInput" Grid.Column="2" Text="{Binding WeekOffsetInput, UpdateSourceTrigger=PropertyChanged}" Height="40" MaxLength="7" VerticalContentAlignment="Center" AllowDrop="False" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="WeekOffsetTextInput" PreviewKeyDown="WeekOffsetKeyDown" DataObject.Pasting="WeekOffsetPasting" AutomationProperties.Name="{Binding [WeeksFromToday], Source={x:Static ui:Strings.Current}}"/>
                <Button x:Name="ShowOffsetDateButton" Grid.Column="4" Click="ShowOffsetDateClick" AutomationProperties.Name="{Binding [ShowDate], Source={x:Static ui:Strings.Current}}">
                  <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE8D1;" Style="{StaticResource ButtonGlyph}"/>
                    <TextBlock Text="{Binding [ShowDate], Source={x:Static ui:Strings.Current}}"/>
                  </ui:SpacingStackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{Binding WeekOffsetErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding WeekOffsetErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </ui:SpacingStackPanel>
            <Expander x:Name="WeekLookupExpander" Header="{Binding [FindWeekDates], Source={x:Static ui:Strings.Current}}" IsExpanded="False" VerticalContentAlignment="Stretch" Expanded="WeekLookupExpanded" PreviewMouseLeftButtonDown="ExpanderHeaderMouseLeftButtonDown">
              <ui:SpacingStackPanel DataContext="{Binding WeekLookup}" Spacing="8" Margin="0,10,0,0">
                <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                  <ui:SpacingStackPanel Spacing="4" Width="128">
                    <TextBlock Text="{Binding [Year], Source={x:Static ui:Strings.Current}}"/>
                    <TextBox x:Name="WeekYearInput" Text="{Binding YearInput, UpdateSourceTrigger=PropertyChanged}" Height="40" MaxLength="4" VerticalContentAlignment="Center" AllowDrop="False" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="WeekLookupTextInput" PreviewKeyDown="WeekLookupKeyDown" DataObject.Pasting="WeekLookupPasting"/>
                  </ui:SpacingStackPanel>
                  <ui:SpacingStackPanel Spacing="4" Width="96">
                    <TextBlock Text="{Binding [Week], Source={x:Static ui:Strings.Current}}"/>
                    <TextBox x:Name="WeekNumberInput" Text="{Binding WeekInput, UpdateSourceTrigger=PropertyChanged}" Height="40" MaxLength="2" VerticalContentAlignment="Center" AllowDrop="False" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="WeekLookupTextInput" PreviewKeyDown="WeekLookupKeyDown" DataObject.Pasting="WeekLookupPasting"/>
                  </ui:SpacingStackPanel>
                  <Button x:Name="FindWeekButton" Click="FindWeekClick" VerticalAlignment="Bottom" AutomationProperties.Name="{Binding [FindDates], Source={x:Static ui:Strings.Current}}">
                    <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="&#xE721;" Style="{StaticResource ButtonGlyph}"/>
                      <TextBlock Text="{Binding [FindDates], Source={x:Static ui:Strings.Current}}"/>
                    </ui:SpacingStackPanel>
                  </Button>
                </ui:SpacingStackPanel>
                <TextBlock Text="{Binding ResultText}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                  <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding ResultText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ui:WeekCopyControl x:Name="LookupWeekCopy" IsEnabled="{Binding CanCopyWeek}">
                  <ui:WeekCopyControl.Style><Style TargetType="ui:WeekCopyControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding CanCopyWeek}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ui:WeekCopyControl.Style>
                </ui:WeekCopyControl>
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                  <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding ErrorText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </ui:SpacingStackPanel>
            </Expander>
          </ui:SpacingStackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="CalendarTab" Header="{Binding [Calendar], Source={x:Static ui:Strings.Current}}">
        <ui:CalendarBrowserPage x:Name="CalendarPage"/>
      </TabItem>
      <TabItem Header="{Binding [DateSpanTab], Source={x:Static ui:Strings.Current}}">
        <ui:DateSpanPage x:Name="DateSpanPage" DataContext="{Binding DateSpan}"/>
      </TabItem>
      <TabItem Header="{Binding [OrdinalTab], Source={x:Static ui:Strings.Current}}">
        <ui:DateLookupPage DataContext="{Binding DayOfYear}"/>
      </TabItem>
      <TabItem Header="{Binding [JulianTab], Source={x:Static ui:Strings.Current}}">
        <ui:DateLookupPage DataContext="{Binding JulianDay}"/>
      </TabItem>
      <TabItem x:Name="PreferencesTab" Header="{Binding [Preferences], Source={x:Static ui:Strings.Current}}">
        <DockPanel Margin="0,14,0,0">
          <ui:SpacingStackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="SaveChangesButton" Click="ActionClick" Tag="save" IsEnabled="{Binding Editor.HasChanges}" AutomationProperties.Name="{Binding [Save], Source={x:Static ui:Strings.Current}}">
              <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE74E;" Style="{StaticResource ButtonGlyph}"/>
                <TextBlock Text="{Binding [Save], Source={x:Static ui:Strings.Current}}"/>
              </ui:SpacingStackPanel>
            </Button>
            <Button x:Name="DiscardChangesButton" Click="ActionClick" Tag="discard" IsEnabled="{Binding Editor.HasChanges}" AutomationProperties.Name="{Binding [Cancel], Source={x:Static ui:Strings.Current}}">
              <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE7A7;" Style="{StaticResource ButtonGlyph}"/>
                <TextBlock Text="{Binding [Cancel], Source={x:Static ui:Strings.Current}}"/>
              </ui:SpacingStackPanel>
            </Button>
          </ui:SpacingStackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
              <Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
          <ScrollViewer x:Name="PreferencesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ui:SpacingStackPanel Spacing="8">
              <Expander Header="{Binding [General], Source={x:Static ui:Strings.Current}}" IsExpanded="True" VerticalContentAlignment="Stretch" PreviewMouseLeftButtonDown="ExpanderHeaderMouseLeftButtonDown">
                <ui:SpacingStackPanel Spacing="8" Margin="0,10,0,0" DataContext="{Binding Editor}">
                  <TextBlock Text="{Binding [LanguageHeading], Source={x:Static ui:Strings.Current}}"/>
                  <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Language}" AutomationProperties.Name="{Binding [LanguageHeading], Source={x:Static ui:Strings.Current}}"/>
                  <TextBlock Text="{Binding [Theme], Source={x:Static ui:Strings.Current}}"/>
                  <ComboBox ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Theme}" AutomationProperties.Name="{Binding [Theme], Source={x:Static ui:Strings.Current}}"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="StartWithWindowsCheck" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Top" AutomationProperties.Name="{Binding [Autostart], Source={x:Static ui:Strings.Current}}">
                      <TextBlock Text="{Binding [Autostart], Source={x:Static ui:Strings.Current}}" TextWrapping="Wrap"/>
                    </CheckBox>
                    <CheckBox x:Name="AlwaysOnTopCheck" Grid.Column="2" IsChecked="{Binding AlwaysOnTop}" Click="AlwaysOnTopClick" VerticalAlignment="Top" AutomationProperties.Name="{Binding [AlwaysOnTop], Source={x:Static ui:Strings.Current}}">
                      <TextBlock Text="{Binding [AlwaysOnTop], Source={x:Static ui:Strings.Current}}" TextWrapping="Wrap"/>
                    </CheckBox>
                  </Grid>
                </ui:SpacingStackPanel>
              </Expander>
              <Expander Header="{Binding [Calendar], Source={x:Static ui:Strings.Current}}" VerticalContentAlignment="Stretch" PreviewMouseLeftButtonDown="ExpanderHeaderMouseLeftButtonDown">
                <ui:SpacingStackPanel Spacing="8" Margin="0,10,0,0" DataContext="{Binding Editor}">
                  <ComboBox ItemsSource="{Binding Modes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" AutomationProperties.Name="{Binding [Convention], Source={x:Static ui:Strings.Current}}"/>
                  <TextBlock Text="{Binding [FirstDay], Source={x:Static ui:Strings.Current}}"/>
                  <ComboBox ItemsSource="{Binding Days}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FirstDay}" IsEnabled="{Binding CustomCalendar}" AutomationProperties.Name="{Binding [FirstDay], Source={x:Static ui:Strings.Current}}"/>
                  <TextBlock Text="{Binding [Rule], Source={x:Static ui:Strings.Current}}"/>
                  <ComboBox ItemsSource="{Binding Rules}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Rule}" IsEnabled="{Binding CustomCalendar}" AutomationProperties.Name="{Binding [Rule], Source={x:Static ui:Strings.Current}}"/>
                </ui:SpacingStackPanel>
              </Expander>
              <Expander Header="{Binding [Icon], Source={x:Static ui:Strings.Current}}" VerticalContentAlignment="Stretch" PreviewMouseLeftButtonDown="ExpanderHeaderMouseLeftButtonDown">
                <ui:SpacingStackPanel Spacing="8" Margin="0,10,0,0" DataContext="{Binding Editor}">
                  <CheckBox IsChecked="{Binding AutomaticIcon}" Content="{Binding [AutoIcon], Source={x:Static ui:Strings.Current}}"/>
                  <ui:SpacingStackPanel Spacing="8" IsEnabled="{Binding CustomIcon}">
                    <ui:SpacingStackPanel.Style>
                      <Style TargetType="ui:SpacingStackPanel"><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></Style.Triggers></Style>
                    </ui:SpacingStackPanel.Style>
                    <TextBlock Text="{Binding [Foreground], Source={x:Static ui:Strings.Current}}"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="8"/><ColumnDefinition Width="160"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border x:Name="ForegroundSwatch" Width="40" Height="40" Background="{Binding Foreground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="{Binding [Foreground], Source={x:Static ui:Strings.Current}}"/>
                      <TextBox Grid.Column="2" Width="160" Height="40" VerticalContentAlignment="Center" Text="{Binding Foreground, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="{Binding [Foreground], Source={x:Static ui:Strings.Current}}"/>
                      <Button Grid.Column="4" Click="ActionClick" Tag="foreground" AutomationProperties.Name="{Binding [ChooseColor], Source={x:Static ui:Strings.Current}}">
                        <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="&#xE790;" Style="{StaticResource ButtonGlyph}"/>
                          <TextBlock Text="{Binding [ChooseColor], Source={x:Static ui:Strings.Current}}"/>
                        </ui:SpacingStackPanel>
                      </Button>
                    </Grid>
                    <TextBlock Text="{Binding [Background], Source={x:Static ui:Strings.Current}}"/>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="8"/><ColumnDefinition Width="160"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border x:Name="BackgroundSwatch" Width="40" Height="40" Background="{Binding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" AutomationProperties.Name="{Binding [Background], Source={x:Static ui:Strings.Current}}"/>
                      <TextBox Grid.Column="2" Width="160" Height="40" VerticalContentAlignment="Center" Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}" MaxLength="9" AutomationProperties.Name="{Binding [Background], Source={x:Static ui:Strings.Current}}"/>
                      <Button Grid.Column="4" Click="ActionClick" Tag="background" AutomationProperties.Name="{Binding [ChooseColor], Source={x:Static ui:Strings.Current}}">
                        <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="&#xE790;" Style="{StaticResource ButtonGlyph}"/>
                          <TextBlock Text="{Binding [ChooseColor], Source={x:Static ui:Strings.Current}}"/>
                        </ui:SpacingStackPanel>
                      </Button>
                    </Grid>
                    <TextBlock Text="{Binding [ColorHelp], Source={x:Static ui:Strings.Current}}" Style="{StaticResource Caption}"/>
                  </ui:SpacingStackPanel>
                  <WrapPanel x:Name="IconActionsPanel" Margin="0,0,-8,-8">
                    <WrapPanel.Resources>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,8,8"/></Style>
                    </WrapPanel.Resources>
                    <Button Click="ActionClick" Tag="reset-icon" IsEnabled="{Binding CustomIcon}" AutomationProperties.Name="{Binding [ResetIcon], Source={x:Static ui:Strings.Current}}">
                      <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource ButtonGlyph}"/>
                        <TextBlock Text="{Binding [ResetIcon], Source={x:Static ui:Strings.Current}}"/>
                      </ui:SpacingStackPanel>
                    </Button>
                    <Button Click="ActionClick" Tag="export-icon" AutomationProperties.Name="{Binding [ExportIcon], Source={x:Static ui:Strings.Current}}">
                      <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource ButtonGlyph}"/>
                        <TextBlock Text="{Binding [ExportIcon], Source={x:Static ui:Strings.Current}}"/>
                      </ui:SpacingStackPanel>
                    </Button>
                  </WrapPanel>
                </ui:SpacingStackPanel>
              </Expander>
              <Expander Header="{Binding [Notifications], Source={x:Static ui:Strings.Current}}" VerticalContentAlignment="Stretch" PreviewMouseLeftButtonDown="ExpanderHeaderMouseLeftButtonDown">
                <ui:SpacingStackPanel Spacing="4" DataContext="{Binding Editor}">
                  <CheckBox IsChecked="{Binding StartupNotification}" Content="{Binding [StartupNote], Source={x:Static ui:Strings.Current}}"/>
                  <CheckBox IsChecked="{Binding WeekNotification}" Content="{Binding [WeekNote], Source={x:Static ui:Strings.Current}}"/>
                  <CheckBox IsChecked="{Binding SilentNotifications}" Content="{Binding [Silent], Source={x:Static ui:Strings.Current}}"/>
                </ui:SpacingStackPanel>
              </Expander>
              <Expander Header="{Binding [Data], Source={x:Static ui:Strings.Current}}" VerticalContentAlignment="Stretch" PreviewMouseLeftButtonDown="ExpanderHeaderMouseLeftButtonDown">
                <ui:SpacingStackPanel Spacing="16">
                  <WrapPanel x:Name="DiagnosticsActionsPanel" Margin="0,0,-8,-8">
                    <CheckBox IsChecked="{Binding Editor.Logging}" Content="{Binding [Logging], Source={x:Static ui:Strings.Current}}" Margin="0,0,8,8"/>
                    <Button Click="ActionClick" Tag="log" Margin="0,0,8,8" AutomationProperties.Name="{Binding [OpenLog], Source={x:Static ui:Strings.Current}}">
                      <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource ButtonGlyph}"/>
                        <TextBlock Text="{Binding [OpenLog], Source={x:Static ui:Strings.Current}}"/>
                      </ui:SpacingStackPanel>
                    </Button>
                  </WrapPanel>
                  <WrapPanel x:Name="SettingsTransferActionsPanel" Margin="0,0,-8,-8">
                    <WrapPanel.Resources>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,8,8"/></Style>
                    </WrapPanel.Resources>
                    <Button Click="ActionClick" Tag="import" AutomationProperties.Name="{Binding [Import], Source={x:Static ui:Strings.Current}}">
                      <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE8B5;" Style="{StaticResource ButtonGlyph}"/>
                        <TextBlock Text="{Binding [Import], Source={x:Static ui:Strings.Current}}"/>
                      </ui:SpacingStackPanel>
                    </Button>
                    <Button Click="ActionClick" Tag="export" AutomationProperties.Name="{Binding [Export], Source={x:Static ui:Strings.Current}}">
                      <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xEDE1;" Style="{StaticResource ButtonGlyph}"/>
                        <TextBlock Text="{Binding [Export], Source={x:Static ui:Strings.Current}}"/>
                      </ui:SpacingStackPanel>
                    </Button>
                  </WrapPanel>
                </ui:SpacingStackPanel>
              </Expander>
            </ui:SpacingStackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="{Binding [About], Source={x:Static ui:Strings.Current}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ui:SpacingStackPanel Spacing="12" Margin="0,20,0,0">
            <TextBlock Text="{Binding VersionText}" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="© 2026 Voltura AB · MIT" Style="{StaticResource Caption}"/>
            <TextBlock Text="{Binding [Updates], Source={x:Static ui:Strings.Current}}" FontWeight="SemiBold"/>
            <CheckBox x:Name="AutomaticUpdateCheck" IsChecked="{Binding Editor.AutomaticUpdates}" Content="{Binding [AutoUpdates], Source={x:Static ui:Strings.Current}}" Checked="AutomaticUpdatesChanged" Unchecked="AutomaticUpdatesChanged"/>
            <TextBlock x:Name="UpdateStatus" Style="{StaticResource Caption}" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="CheckUpdateButton" Click="ActionClick" Tag="check-update" HorizontalAlignment="Left" AutomationProperties.Name="{Binding [CheckUpdates], Source={x:Static ui:Strings.Current}}">
              <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="CheckUpdateGlyph" Text="&#xE72C;" Style="{StaticResource ButtonGlyph}"/>
                <TextBlock x:Name="CheckUpdateLabel" Text="{Binding [CheckUpdates], Source={x:Static ui:Strings.Current}}"/>
              </ui:SpacingStackPanel>
            </Button>
            <Button x:Name="InstallButton" Click="ActionClick" Tag="install-update" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="{Binding [Install], Source={x:Static ui:Strings.Current}}">
              <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="&#xE777;" Style="{StaticResource ButtonGlyph}"/>
                <TextBlock Text="{Binding [Install], Source={x:Static ui:Strings.Current}}"/>
              </ui:SpacingStackPanel>
            </Button>
            <WrapPanel Margin="0,0,-8,-8">
              <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Margin" Value="0,0,8,8"/>
                </Style>
              </WrapPanel.Resources>
              <Button Click="ActionClick" Tag="project" AutomationProperties.Name="{Binding [Project], Source={x:Static ui:Strings.Current}}">
                <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="&#xE774;" Style="{StaticResource ButtonGlyph}"/>
                  <TextBlock Text="{Binding [Project], Source={x:Static ui:Strings.Current}}"/>
                </ui:SpacingStackPanel>
              </Button>
              <Button Click="ActionClick" Tag="license" AutomationProperties.Name="{Binding [License], Source={x:Static ui:Strings.Current}}">
                <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="&#xE8A5;" Style="{StaticResource ButtonGlyph}"/>
                  <TextBlock Text="{Binding [License], Source={x:Static ui:Strings.Current}}"/>
                </ui:SpacingStackPanel>
              </Button>
              <Button Click="ActionClick" Tag="donate" AutomationProperties.Name="{Binding [Donate], Source={x:Static ui:Strings.Current}}">
                <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="&#xEB51;" Style="{StaticResource ButtonGlyph}"/>
                  <TextBlock Text="{Binding [Donate], Source={x:Static ui:Strings.Current}}"/>
                </ui:SpacingStackPanel>
              </Button>
              <Button Click="ActionClick" Tag="coffee" AutomationProperties.Name="{Binding [Coffee], Source={x:Static ui:Strings.Current}}">
                <ui:SpacingStackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="&#xE719;" Style="{StaticResource ButtonGlyph}"/>
                  <TextBlock Text="{Binding [Coffee], Source={x:Static ui:Strings.Current}}"/>
                </ui:SpacingStackPanel>
              </Button>
            </WrapPanel>
          </ui:SpacingStackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
